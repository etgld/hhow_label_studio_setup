<View>
  <Relations>
    <!-- TLINK types -->
    <Relation value="BEFORE"/>
    <Relation value="CONTAINS"/>
    <Relation value="OVERLAP"/>
    <Relation value="BEGINS-ON"/>
    <Relation value="ENDS-ON"/>
  </Relations>
  <View style="display:flex;align-items:start;gap:8px;flex-direction:column-reverse">
    <Text name="text" value="$text" granularity="word"/>
    <TextArea name="CUI" toName="text" editable="true"
              showSubmitButton="true" transcription="false"
              perRegion="true" required="false" maxSubmissions="1"
              rows="5" placeholder="Non UMLS Concept"
              displayMode="region-list"/>
    <Choices name="DocTimeRel" toName="text" perRegion="true">
      <Choice value="BEFORE"/>
      <Choice value="OVERLAP"/>
      <Choice value="BEFORE-OVERLAP"/>
      <Choice value="AFTER"/>
    </Choices>
    <Choices name="Contextual Modality" toName="text" perRegion="true">
      <Choice value="ACTUAL"/>
      <Choice value="HEDGED"/>
      <Choice value="HYPOTHETICAL"/>
      <Choice value="GENERIC"/>
    </Choices>
    <Choices name="Polarity" toName="text" perRegion="true">
      <Choice value="POS"/>
      <Choice value="NEG"/>
    </Choices>
    <Labels name="EVENT" toName="text" showInline="true">
      <Label value="EVENT" background="rebeccapurple"/>
    </Labels>
    <Labels name="TIMEX3" toName="text" showInline="true">
      <Label value="TIMEX" background="paleturquoise"/>
    </Labels>
  </View>
</View>
